# API: production is the default. Never enable development mode on a public deployment.
PLUTUS_ENV=production
DATABASE_URL=postgresql+psycopg://ROLE:PASSWORD@HOST:5432/postgres?sslmode=require
APP_ORIGIN=https://YOUR_FRONTEND_HOST
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Next.js: server-side reverse proxy origin; no browser API secrets.
API_ORIGIN=https://YOUR_BACKEND_HOST
# Planned integrations: NOT wired into this foundation release.
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPSTOX_SANDBOX_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
REDIS_URL=
SENTRY_DSN=
